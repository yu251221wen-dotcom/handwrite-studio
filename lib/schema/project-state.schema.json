{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://handwrite.studio/schema/project-state-v3.json",
  "title": "Handwrite Studio Project State V3",
  "type": "object",
  "required": [
    "schemaVersion", "projectVersion", "id", "document", "layoutMode", "noTemplateMode",
    "documentBlocks", "mappedBlockIds", "unmappedBlockIds", "explicitlyIgnoredBlockIds",
    "documentLayoutSettings", "seed", "selectedFontId", "fieldMappings", "pages",
    "handwriting", "exportSettings", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "projectVersion": { "type": "string" },
    "id": { "type": "string" },
    "document": {
      "type": "object",
      "required": ["id", "name", "rawTexts", "sourceCharacterCount"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "rawTexts": { "type": "array", "items": { "type": "string" } },
        "sourceCharacterCount": { "type": "integer", "minimum": 0 }
      }
    },
    "layoutMode": { "enum": ["no-template", "template"], "$comment": "template is accepted only for legacy V3 import and is normalized to no-template" },
    "noTemplateMode": { "enum": ["preserve-structure", "simplified"] },
    "templateId": { "type": ["string", "null"] },
    "documentBlocks": { "type": "array", "items": { "$ref": "#/$defs/documentBlock" } },
    "mappedBlockIds": { "type": "array", "items": { "type": "string" }, "$comment": "deprecated compatibility field; V3.1 writes an empty array" },
    "unmappedBlockIds": { "type": "array", "items": { "type": "string" }, "$comment": "deprecated compatibility field; V3.1 writes an empty array" },
    "explicitlyIgnoredBlockIds": { "type": "array", "items": { "type": "string" } },
    "documentLayoutSettings": { "type": "object" },
    "seed": { "type": "string" },
    "selectedFontId": { "type": "string" },
    "fieldMappings": { "type": "array", "items": { "$ref": "#/$defs/fieldMapping" } },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "handwriting": { "type": "object" },
    "inkStyle": { "$ref": "#/$defs/inkStyle" },
    "correctionStyle": { "$ref": "#/$defs/correctionStyle" },
    "footerMode": { "enum": ["auto", "native", "generated", "hidden"] },
    "tableLineMode": { "enum": ["auto", "hidden", "adaptive", "visible"] },
    "tableLineStyle": {
      "type": "object",
      "required": ["color", "alpha", "width"],
      "properties": {
        "color": { "type": "string" },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0.1, "maximum": 4 }
      },
      "additionalProperties": false
    },
    "exportSettings": { "type": "object" },
    "updatedAt": { "type": "string" }
  },
  "$defs": {
    "inkStyle": {
      "type": "object",
      "required": ["enabled", "color", "variation", "bleed", "dryBrush", "brokenInk", "darknessTrend"],
      "properties": {
        "enabled": { "type": "boolean" }, "color": { "type": "string" },
        "variation": { "type": "number", "minimum": 0, "maximum": 1 },
        "bleed": { "type": "number", "minimum": 0, "maximum": 1 },
        "dryBrush": { "type": "number", "minimum": 0, "maximum": 1 },
        "brokenInk": { "type": "number", "minimum": 0, "maximum": 1 },
        "darknessTrend": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "correctionStyle": {
      "type": "object",
      "required": ["enabled", "automatic", "automaticProbability", "marks"],
      "properties": {
        "enabled": { "type": "boolean" }, "automatic": { "type": "boolean" },
        "automaticProbability": { "type": "number", "minimum": 0, "maximum": 0.1 },
        "marks": { "type": "array", "items": { "$ref": "#/$defs/correctionMark" } }
      },
      "additionalProperties": false
    },
    "correctionMark": {
      "type": "object",
      "required": ["id", "blockId", "sourceStart", "sourceEnd", "sourceText", "type"],
      "properties": {
        "id": { "type": "string" }, "blockId": { "type": "string" },
        "sourceStart": { "type": "integer", "minimum": 0 }, "sourceEnd": { "type": "integer", "minimum": 1 },
        "sourceText": { "type": "string" },
        "type": { "enum": ["single-strike", "double-strike", "diagonal", "scribble", "caret", "rewrite-above", "rewrite-side"] },
        "replacementText": { "type": "string" }
      },
      "additionalProperties": false
    },
    "documentBlock": {
      "type": "object",
      "required": ["blockId", "type", "sourceOrder", "sourceStart", "sourceEnd", "sourceText"],
      "properties": {
        "blockId": { "type": "string" },
        "type": { "enum": ["heading", "paragraph", "key-value", "list", "table", "prescription", "signature"] },
        "sourceOrder": { "type": "integer", "minimum": 0 },
        "sourceStart": { "type": "integer", "minimum": 0 },
        "sourceEnd": { "type": "integer", "minimum": 0 },
        "sourceText": { "type": "string" }
      },
      "additionalProperties": true
    },
    "fieldMapping": {
      "type": "object",
      "required": ["id", "label", "value", "sourceText", "confidence", "confirmed", "role"],
      "properties": {
        "id": { "type": "string" }, "label": { "type": "string" }, "value": { "type": "string" },
        "sourceText": { "type": "string" }, "confidence": { "type": "number" },
        "confirmed": { "type": "boolean" }, "role": { "enum": ["patient", "body"] },
        "sourceBlockIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "line": {
      "type": "object",
      "properties": {
        "sourceCharacterIndices": { "type": "array", "items": { "type": "integer", "minimum": -1 } },
        "lineSnapOffset": { "type": "number" },
        "assignedPaperLineY": { "type": "number" },
        "assignedPaperLineIndex": { "type": "integer" }
      },
      "required": ["id", "pageId", "fieldId", "label", "text", "startIndex", "endIndex", "autoX", "autoY", "manualOffsetX", "manualOffsetY", "rotation", "fontSize", "letterSpacing", "lineHeight", "fontId", "locked"]
    },
    "page": {
      "type": "object",
      "required": ["pageId", "pageIndex", "templateId", "widthMm", "heightMm", "backgroundId", "backgroundAdjustments", "backgroundTransform", "lineDetection", "lines"],
      "properties": {
        "pageId": { "type": "string" }, "pageIndex": { "type": "integer", "minimum": 0 },
        "pageType": { "enum": ["first", "continuation", "blank", "custom"] },
        "pageTemplateId": { "type": ["string", "null"] }, "templateId": { "type": "string" },
        "widthMm": { "const": 210 }, "heightMm": { "const": 297 }, "backgroundId": { "type": "string" },
        "backgroundAdjustments": { "type": "object" }, "backgroundTransform": { "type": "object" },
        "backgroundHasNativePageFooter": { "type": "boolean" },
        "lineDetection": {
          "type": "object",
          "required": ["enabled", "lineY", "averageSpacing", "confidence", "snapEnabled", "offsetY", "showLines", "firstUsableLine", "lastUsableLine", "writableLeft", "writableRight", "source"],
          "properties": {
            "enabled": { "type": "boolean" },
            "lineY": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 842 } },
            "averageSpacing": { "type": "number", "minimum": 12, "maximum": 120 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "snapEnabled": { "type": "boolean" },
            "offsetY": { "type": "number" },
            "showLines": { "type": "boolean" },
            "firstUsableLine": { "type": "integer", "minimum": 0 },
            "lastUsableLine": { "type": "integer", "minimum": -1 },
            "writableLeft": { "type": "number", "minimum": 0, "maximum": 534 },
            "writableRight": { "type": "number", "minimum": 60, "maximum": 595 },
            "source": { "enum": ["none", "preset", "detected", "manual"] }
          },
          "additionalProperties": false
        },
        "blockIds": { "type": "array", "items": { "type": "string" } },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } }
      }
    }
  },
  "additionalProperties": false
}
