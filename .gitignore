# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm*/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/build/
/.wrangler/
*.tsbuildinfo
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/data/
/outputs/
/output/
/.logs/
/.tmp/
/public/ocr/
/work/
/acceptance-clean/
/tmp/
/temp/
/.venv/
__pycache__/
*.pyc
# DOCX fixtures are private by default. Only the explicitly synthetic V2 fixtures
# are safe to publish; real Golden/reference records stay local-only.
/tests/fixtures/**/*.docx
!/tests/fixtures/v2/
!/tests/fixtures/v2/*.docx
